---
/* =========================================================================
   Sala de práctica de un examen concreto.

   Página estática por examen: el cronómetro es del navegador y el estado vive
   en sessionStorage, así que no hay servidor que sostener ni cuenta que crear.
   ========================================================================= */
import Base from '../../layouts/Base.astro';
import HeadNav from '../../components/HeadNav.astro';
import OpenIcon from '../../components/icons/Open.astro';
import { DOC_TYPES, SESSIONS, loadSubjects, type DocType } from '../../lib/catalog';
import { practiceSets, type PracticeSet } from '../../lib/practice';

type Props = { set: PracticeSet };

export function getStaticPaths() {
  return practiceSets().map((set) => ({ params: { set: set.slug }, props: { set } }));
}

const { set } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pdfUrl = (file: string) => `${base}/${file.replace(/^\//, '')}`;

const subjects = loadSubjects();
const subjectName = subjects.find((s) => s.code === set.subject)?.name ?? set.subject;
const sessionLong = SESSIONS.find((s) => s.id === set.session)?.long ?? set.session;
const sessionShort = SESSIONS.find((s) => s.id === set.session)?.label ?? set.session;
const typeLabel = (id: string) => DOC_TYPES.find((t) => t.id === id)?.label ?? id;

const DURATIONS = [60, 90, 120, 180];
const DEFAULT_MINUTES = 90;
const corrections = (['soluciones', 'criterios', 'plantilla'] as DocType[]).filter(
  (type) => set.docs[type]
);

const enunciado = set.docs.enunciados!;

/* páginas y peso que se leen bajo el visor, para cada documento */
const facts = (exam: { pages?: number | null; sizeKB?: number | null }): string =>
  [
    exam.pages ? `${exam.pages} p.` : null,
    exam.sizeKB
      ? exam.sizeKB < 1024
        ? `${exam.sizeKB} KB`
        : `${(exam.sizeKB / 1024).toFixed(1)} MB`
      : null,
  ]
    .filter(Boolean)
    .join('  ·  ');

/* el enunciado primero: es lo que se lee hasta que suena el cronómetro */
const documents = [
  { id: 'enunciados', label: 'Enunciado', file: pdfUrl(enunciado.file), meta: facts(enunciado) },
  ...corrections.map((type) => ({
    id: type,
    label: typeLabel(type),
    file: pdfUrl(set.docs[type]!.file),
    meta: facts(set.docs[type]!),
  })),
];
---

<Base
  title={`Practicar ${subjectName} · ${set.year} · ${sessionShort} — WebPAU`}
  description={`Haz el examen de ${subjectName} de la convocatoria ${sessionShort.toLowerCase()} de ${set.year} a tiempo y comprueba tus respuestas con sus soluciones y criterios.`}
>
  <header class="site-head">
    <div class="wrap head-bar">
      <a class="brand" href={`${base}/`}>
        <span class="mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        WebPAU
      </a>
      <HeadNav current="practica" />
      <a class="cta" href={`${base}/`}>Volver al archivo</a>
    </div>
  </header>

  <main>
    <section class="hero practice-hero">
      <div class="wrap">
        <p class="kicker">Práctica · {set.year}</p>
        <h1>{subjectName}</h1>
        <p class="lede">
          {sessionLong} de {set.year}.           Elige cuánto tiempo quieres darte, haz el examen con el enunciado delante y, al
          terminar, la corrección aparece en el mismo panel.
        </p>
        <p class="practice-back">
          <a href={`${base}/practica`}>← Elegir otro examen</a>
        </p>
      </div>
    </section>

    <section class="practice-run">
      <div class="wrap practice-grid">
        <section class="timer" aria-labelledby="timerTitle" data-reveal>
          <h2 class="practice-sub" id="timerTitle">Cronómetro</h2>
          <p class="clock" id="clock" role="timer" data-state="idle">{DEFAULT_MINUTES}:00</p>
          <p class="timer-state" id="clockState" aria-live="polite">
            Sin empezar. Elige la duración y pulsa «Empezar».
          </p>

          <div class="timer-controls">
            <label class="visually-hidden" for="duration">Duración del examen</label>
            <select class="select" id="duration">
              {DURATIONS.map((minutes) => (
                <option value={minutes} selected={minutes === DEFAULT_MINUTES}>
                  {minutes} min
                </option>
              ))}
            </select>
            <button class="btn-primary" id="btnStart" type="button">Empezar</button>
            <button class="btn-ghost" id="btnPause" type="button" hidden>Pausar</button>
            <button class="btn-ghost" id="btnFinish" type="button" hidden>Terminar</button>
            <button class="btn-ghost" id="btnReset" type="button" hidden>Reiniciar</button>
          </div>

          <p class="timer-hint">
            El tiempo se guarda en esta pestaña: si refrescas, el cronómetro sigue donde estaba.
          </p>
        </section>

        <section class="reader" aria-labelledby="readerTitle" data-reveal>
          <div class="reader-head">
            <h2 class="practice-sub" id="readerTitle" data-reader-title>Enunciado</h2>
            <div class="reader-actions">
              <span class="reader-total mono" data-page-total></span>
              <div class="reader-zoom" data-zoom-controls hidden>
                <button type="button" data-zoom="-1" aria-label="Alejar el documento">−</button>
                <span class="mono" data-zoom-level aria-live="polite">100%</span>
                <button type="button" data-zoom="1" aria-label="Acercar el documento">+</button>
              </div>
              <a
                class="dl"
                href={pdfUrl(enunciado.file)}
                target="_blank"
                rel="noreferrer"
                data-reader-open
              >
                <OpenIcon /><span>Abrir</span>
              </a>
            </div>
          </div>
          <div
            class="reader-tabs"
            data-reader-tabs
            role="group"
            aria-label="Documentos del examen"
            hidden
          >
            {documents.map((doc, index) => (
              <button
                type="button"
                data-doc={index}
                aria-pressed={index === 0 ? 'true' : 'false'}
              >
                {doc.label}
              </button>
            ))}
          </div>
          {/* El enunciado se dibuja aquí con pdf.js: el borde sirve los PDF con
              `frame-ancestors 'none'`, así que un iframe se queda en blanco. */}
          <div class="reader-view" id="pdfView" data-src={pdfUrl(enunciado.file)}>
            <p class="reader-loading mono">Cargando el enunciado…</p>
          </div>
          <p class="reader-fallback mono">
            <span>{set.year} · {sessionShort}</span>
            <span class="sep" aria-hidden="true">·</span>
            <span data-reader-meta>{documents[0]!.meta}</span>
            <span class="sep" aria-hidden="true">·</span>
            <a
              href={pdfUrl(enunciado.file)}
              target="_blank"
              rel="noreferrer"
              data-reader-open
            >
              abrir en otra pestaña
            </a>
          </p>
        </section>
      </div>

    </section>
  </main>

  <script
    type="application/json"
    id="practice-data"
    set:html={JSON.stringify({
      key: set.key,
      minutes: DEFAULT_MINUTES,
      corrections: corrections.length > 0,
      docs: documents,
    })}
  />
  <script>
    import '../../scripts/practice.ts';
    import '../../scripts/pdf-reader.ts';
  </script>
</Base>
