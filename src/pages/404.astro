---
import Base from '../layouts/Base.astro';
import ArrowIcon from '../components/icons/Arrow.astro';
import GitHubIcon from '../components/icons/GitHub.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base
  title="Página no encontrada · WebPAU"
  description="Esta página no existe en WebPAU. Vuelve al archivo de exámenes."
>
  <header class="site-head">
    <div class="wrap head-bar">
      <a class="brand" href={`${base}/`}>
        <span class="mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        WebPAU
      </a>
      <a
        class="cta"
        href="https://github.com/ElioXY/WebPAU"
        target="_blank"
        rel="noreferrer"
      >GitHub</a>
    </div>
  </header>

  <main>
    <div class="wrap notfound">
      <p class="badge" aria-hidden="true">404</p>
      <h1>Esta página no está en el archivo</h1>
      <p>
        La dirección que has seguido no existe. Puede que el enlace esté mal escrito o que
        el examen se haya retirado del archivo.
      </p>
      <p class="empty-cta">
        <a class="dl" href={`${base}/#archivo`}>
          <ArrowIcon /><span>Ir al archivo</span>
        </a>
      </p>
      <p class="owner-note mono">
        ¿Buscabas un examen que no está? Abre un issue en
        <a href="https://github.com/ElioXY/WebPAU/issues" target="_blank" rel="noreferrer">
          <GitHubIcon /> GitHub
        </a>.
      </p>
    </div>
  </main>
</Base>
