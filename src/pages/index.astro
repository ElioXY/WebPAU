---
/* =========================================================================
   Portada.

   La portada ya no vuelca las 1.281 filas del catálogo: enseña el archivo
   como un índice —ficha, asignaturas y los últimos documentos— y manda a
   `/archivo` para buscar y filtrar el resto. Así la página pesa poco y se
   lee de un vistazo.
   ========================================================================= */
import Base from '../layouts/Base.astro';
import HeadNav from '../components/HeadNav.astro';
import {
  DOC_TYPES,
  SESSIONS,
  loadCatalog,
  loadSubjects,
  subjectLabel,
  subjectRoutes,
  type Subject,
} from '../lib/catalog';
import SearchIcon from '../components/icons/Search.astro';
import OpenIcon from '../components/icons/Open.astro';
import ArrowIcon from '../components/icons/Arrow.astro';
import NextExam from '../components/NextExam.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pdfUrl = (file: string) => `${base}/${file.replace(/^\//, '')}`;

const catalog = loadCatalog();
const subjects = loadSubjects();
const exams = catalog.exams;

const typeById = new Map(DOC_TYPES.map((t) => [t.id, t]));
const sessionShort = new Map(SESSIONS.map((s) => [s.id, s.label]));

const years = [...new Set(exams.map((e) => e.year))].sort((a, b) => b - a);

const yearCounts = new Map<number, number>();
const subjectCounts = new Map<string, number>();
const subjectYears = new Map<string, number[]>();
for (const exam of exams) {
  yearCounts.set(exam.year, (yearCounts.get(exam.year) ?? 0) + 1);
  subjectCounts.set(exam.subject, (subjectCounts.get(exam.subject) ?? 0) + 1);
  const list = subjectYears.get(exam.subject) ?? [];
  if (!list.includes(exam.year)) list.push(exam.year);
  subjectYears.set(exam.subject, list);
}
for (const list of subjectYears.values()) list.sort((a, b) => b - a);

/* resumen de convocatorias para la ficha: «jun · sep · modelos» */
const sessionIds = new Set(exams.map((e) => e.session));
const sessionSummary =
  SESSIONS.filter((s) => sessionIds.has(s.id))
    .map((s) => (s.id === 'ordinaria' ? 'jun' : s.id === 'extraordinaria' ? 'sep' : 'modelos'))
    .join(' · ') || '—';

const range = years.length
  ? years.length === 1
    ? String(years[0])
    : `${years[years.length - 1]}–${years[0]}`
  : '—';

const statDocs = exams.length;
const statSubjects = new Set(exams.map((e) => e.subject)).size;

/* el mosaico enseña solo las materias que ya tienen documentos; si un examen
   trae una asignatura sin ficha, se añade con su código en vez de perderse */
const usedCodes = new Set(exams.map((e) => e.subject));
const visibleSubjects: Subject[] = subjects.filter((s) => usedCodes.has(s.code));
for (const code of usedCodes) {
  if (!visibleSubjects.some((s) => s.code === code)) {
    visibleSubjects.push({ code, name: code, short: code, phases: [], aliases: [] });
  }
}

const subjectPhases = new Map(visibleSubjects.map((s) => [s.code, s.phases.join(',')]));
const subjectLinks = subjectRoutes(
  visibleSubjects.map((s) => s.code),
  subjects
);

/* la portada enseña la punta del archivo: el catálogo ya viene ordenado */
const RECENT = 12;
const recent = exams.slice(0, RECENT);
const footSubjects = visibleSubjects.slice(0, 8);

const fmtSize = (kb?: number | null) =>
  !kb ? '' : kb < 1024 ? `${kb} KB` : `${(kb / 1024).toFixed(1)} MB`;

const yearLabel = (list: number[]) =>
  list.length === 0
    ? 'sin documentos'
    : list.length <= 3
      ? list.join(', ')
      : `${list[list.length - 1]}–${list[0]}`;

const phaseLabel = (phases: string[]) =>
  phases.map((p) => (p === 'acceso' ? 'Fase de acceso' : 'Fase de admisión')).join(' · ');
---

<Base
  title="WebPAU · Todos los exámenes de la PAU en Andalucía"
  description="Archivo de enunciados, soluciones y criterios de corrección de la PAU en Andalucía. Filtra por asignatura, año, convocatoria y fase y ábrelos en el navegador."
>
  <header class="site-head">
    <div class="wrap head-bar">
      <a class="brand" href={`${base}/`}>
        <span class="mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        WebPAU
      </a>
      <HeadNav home withAsignaturas={exams.length > 0} />
      <p class="head-meta mono">
        <span class="hide-s">{statDocs} documentos</span>
        <span class="sep hide-s" aria-hidden="true">·</span>
        <span class="hide-s">{statSubjects} asignaturas</span>
      </p>
      {/* el acceso a la sala de práctica, siempre a la vista: en móvil la
          navegación de secciones se oculta y este botón queda como entrada */}
      <a class="cta cta-practice" href={`${base}/practica`}>Practicar</a>
      <a
        class="cta"
        href="https://github.com/ElioXY/WebPAU"
        target="_blank"
        rel="noreferrer"
      >GitHub</a>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="wrap">
        <div class="hero-grid">
          <div class="hero-copy">
            <p class="kicker">Prueba de Acceso a la Universidad · Andalucía</p>
            <h1>El archivo de exámenes, <em>ordenado como un libro</em>.</h1>
            <p class="lede">
              Enunciados, soluciones y criterios de corrección de la PAU en Andalucía,
              reunidos por asignatura, año y convocatoria. Elige una materia y abre sus
              PDFs en el navegador.
            </p>

            <NextExam />
          </div>

          <aside class="ficha" aria-label="Ficha del archivo">
            <h2>Ficha del archivo</h2>
            <dl>
              <div><dt>Documentos</dt><dd>{statDocs}</dd></div>
              <div><dt>Asignaturas</dt><dd>{statSubjects}</dd></div>
              <div><dt>Años</dt><dd>{range}</dd></div>
              <div><dt>Convocatorias</dt><dd>{sessionSummary}</dd></div>
            </dl>
          </aside>
        </div>

        {exams.length > 0 && (
          <form
            class="filters home-search"
            role="search"
            action={`${base}/archivo`}
            method="get"
            autocomplete="off"
          >
            <div class="filter-row find">
              <div class="field grow">
                <SearchIcon />
                <label class="visually-hidden" for="q">Buscar en el archivo</label>
                <input
                  class="input"
                  id="q"
                  name="q"
                  type="search"
                  placeholder="Buscar asignatura, año o convocatoria…"
                />
              </div>

              <label class="visually-hidden" for="y">Año</label>
              <select class="select" id="y" name="y">
                <option value="">Todos los años</option>
                {years.map((year) => (
                  <option value={year}>{year} · {yearCounts.get(year)}</option>
                ))}
              </select>

              <button class="btn-primary" type="submit">Buscar</button>
            </div>
          </form>
        )}
      </div>
    </section>

    {exams.length > 0 && (
      <section class="subjects" id="asignaturas">
        <div class="wrap">
          <div class="results-head" data-reveal>
            <h2>Explora por asignatura</h2>
            <p class="count">
              {statSubjects} {statSubjects === 1 ? 'materia' : 'materias'} · {range}
            </p>
          </div>

          <div class="legend" data-reveal>
            <span><i aria-hidden="true"></i> Fase de acceso</span>
            <span><i data-phase="admision" aria-hidden="true"></i> Fase de admisión</span>
          </div>

          <div class="chips" role="group" aria-label="Asignatura">
            <a class="chip chip-all" data-reveal href={`${base}/archivo`}>
              <span class="nm">Todas las asignaturas</span>
              <span class="ct">
                <em>{statDocs}</em> <span class="unit">docs.</span> · {range}
              </span>
            </a>

            {visibleSubjects.map((subject) => {
              const list = subjectYears.get(subject.code) ?? [];
              const count = subjectCounts.get(subject.code) ?? 0;
              return (
                <a
                  class="chip"
                  data-reveal
                  href={`${base}/asignatura/${subjectLinks.get(subject.code)}`}
                  title={`${subject.name} · ${phaseLabel(subject.phases)}`}
                >
                  <span class="nm">{subject.name}</span>
                  <span class="ct">
                    <em>{count}</em> <span class="unit">{count === 1 ? 'doc.' : 'docs.'}</span> · {yearLabel(
                      list
                    )}
                  </span>
                </a>
              );
            })}
          </div>
        </div>
      </section>
    )}

    {exams.length > 0 && (
      <section class="archive home-recent" id="ultimos">
        <div class="wrap">
          <div class="results-head" data-reveal>
            <h2>Lo último del archivo</h2>
            <p class="count">
              {recent.length} de {statDocs} documentos
            </p>
          </div>

          <div class="recent">
            {recent.map((exam) => {
              const type = typeById.get(exam.type) ?? {
                id: exam.type,
                short: exam.type,
                label: exam.type,
                hint: 'Tipo de documento no reconocido',
              };
              const meta = [
                exam.year,
                sessionShort.get(exam.session) ?? exam.session,
                exam.pages ? `${exam.pages} p.` : null,
                fmtSize(exam.sizeKB),
              ]
                .filter(Boolean)
                .join('  ·  ');
              return (
                <div
                  class="row"
                  data-t={exam.type}
                  data-p={subjectPhases.get(exam.subject) ?? ''}
                  data-reveal
                >
                  <span class="stripe" aria-hidden="true" />
                  <span class="row-code mono" aria-hidden="true">{exam.subject}</span>
                  <div class="row-title">
                    <a
                      href={pdfUrl(exam.file)}
                      title={exam.notes || undefined}
                      target="_blank"
                      rel="noreferrer"
                    >
                      {subjectLabel(subjects, exam.subject)}
                    </a>
                    <p class="row-meta">{meta}</p>
                  </div>
                  <span class="tag" data-t={exam.type} title={type.hint}>
                    <i aria-hidden="true"></i>
                    {type.short}
                  </span>
                  <div class="row-actions">
                    <a
                      class="dl"
                      href={pdfUrl(exam.file)}
                      target="_blank"
                      rel="noreferrer"
                    >
                      <OpenIcon /><span>Ver</span>
                    </a>
                  </div>
                </div>
              );
            })}
          </div>

          <p class="recent-foot" data-reveal>
            <a class="dl" href={`${base}/archivo`}>
              <span>Ver los {statDocs} documentos del archivo</span>
              <ArrowIcon />
            </a>
          </p>
        </div>
      </section>
    )}

    {exams.length === 0 && (
      <section class="archive">
        <div class="wrap">
          <div class="empty empty-state" id="catalogEmpty">
            <p class="badge" aria-hidden="true">0</p>
            <h2>Aún no hay nada en el archivo</h2>
            <p>
              Todavía no se ha publicado ningún examen. Cuando haya PDFs, aparecerán aquí
              ordenados por asignatura, año y convocatoria, listos para consultar.
            </p>
            <p class="empty-cta">
              <a
                class="dl"
                href="https://github.com/ElioXY/WebPAU"
                target="_blank"
                rel="noreferrer"
              >
                <span>Ver el proyecto en GitHub</span>
              </a>
            </p>
            <p class="owner-note mono">
              Si gestionas el archivo: entra en <code>/admin</code> con tu token de GitHub,
              sube el primero y pulsa «Publicar».
            </p>
          </div>
        </div>
      </section>
    )}
  </main>

  <footer class="site-foot">
    <div class="wrap">
      <div class="foot-grid">
        <div>
          <h3>Sobre WebPAU</h3>
          <p>
            Archivo abierto de exámenes de la PAU en Andalucía. Cada documento se guarda
            en este repositorio con su asignatura, año, convocatoria y tipo, para que se
            pueda encontrar sin saber de dónde viene.
          </p>
        </div>
        <div>
          <h3>Asignaturas</h3>
          {footSubjects.length > 0 ? (
            <ul>
              {footSubjects.map((subject) => (
                <li>
                  <a href={`${base}/asignatura/${subjectLinks.get(subject.code)}`}>
                    {subject.name} <span class="mono">{subjectCounts.get(subject.code) ?? 0}</span>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p>Todavía no hay asignaturas con documentos publicados.</p>
          )}
        </div>
        <div>
          <h3>El proyecto</h3>
          <ul>
            <li><a href={`${base}/archivo`}>El archivo completo</a></li>
            <li><a href={`${base}/practica`}>Practicar un examen</a></li>
            <li><a href="https://github.com/ElioXY/WebPAU" target="_blank" rel="noreferrer">Código en GitHub</a></li>
            <li><a href="https://github.com/ElioXY/WebPAU/issues" target="_blank" rel="noreferrer">Falta un examen</a></li>
            <li><a href={`${base}/404`}>Página no encontrada</a></li>
          </ul>
        </div>
      </div>
      <p class="foot-note">
        Los documentos son de propiedad de los organismos que los emiten. WebPAU solo los
        reúne y los hace accesibles: si eres el titular de un documento y prefieres que
        no se difunda, abre un issue en el repositorio y lo quitamos.
      </p>
    </div>
  </footer>
</Base>
