---
import Base from '../layouts/Base.astro';
import {
  DOC_TYPES,
  SESSIONS,
  loadCatalog,
  loadSubjects,
  subjectLabel,
  type Session,
} from '../lib/catalog';
import SearchIcon from '../components/icons/Search.astro';
import OpenIcon from '../components/icons/Open.astro';
import GitHubIcon from '../components/icons/GitHub.astro';
import NextExam from '../components/NextExam.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pdfUrl = (file: string) => `${base}/${file.replace(/^\//, '')}`;

const catalog = loadCatalog();
const subjects = loadSubjects();
const exams = catalog.exams;

const typeOrder = DOC_TYPES.map((t) => t.id);
const typeById = new Map(DOC_TYPES.map((t) => [t.id, t]));
const sessionOrder = SESSIONS.map((s) => s.id);
const sessionLong = new Map(SESSIONS.map((s) => [s.id, s.long]));

const years = [...new Set(exams.map((e) => e.year))].sort((a, b) => b - a);
const recentYears = years.slice(0, 4);
const range = years.length
  ? years.length === 1
    ? String(years[0])
    : `${years[years.length - 1]}–${years[0]}`
  : '—';

const statDocs = exams.length;
const statSubjects = new Set(exams.map((e) => e.subject)).size;

/* recuento y años de cada asignatura, para las tarjetas del mosaico */
const subjectCounts = new Map<string, number>();
const subjectYears = new Map<string, number[]>();
const yearCounts = new Map<number, number>();
for (const e of exams) {
  subjectCounts.set(e.subject, (subjectCounts.get(e.subject) ?? 0) + 1);
  yearCounts.set(e.year, (yearCounts.get(e.year) ?? 0) + 1);
  const list = subjectYears.get(e.subject) ?? [];
  if (!list.includes(e.year)) list.push(e.year);
  subjectYears.set(e.subject, list);
}
for (const list of subjectYears.values()) list.sort((a, b) => b - a);

/* las asignaturas que enseña el sitio: las que tienen documentos o son de acceso */
const usedCodes = new Set(exams.map((e) => e.subject));
const accesoCodes = new Set(
  subjects.filter((s) => s.phases.includes('acceso')).map((s) => s.code)
);
const visibleSubjects = subjects.filter((s) => usedCodes.has(s.code) || accesoCodes.has(s.code));

/* el payload del cliente debe usar el MISMO orden que las tarjetas:
   si no, el índice de asignatura que viaja en cada fila apunta a otra materia */
const subjectOrder = visibleSubjects.map((s) => s.code);
const subjectPhases = new Map(visibleSubjects.map((s) => [s.code, s.phases.join(',')]));

/* datos compactos para el cliente: [id, subjectIdx, year, sessionIdx, typeIdx] */
const compact = exams.map((e) => [
  e.id,
  subjectOrder.indexOf(e.subject),
  e.year,
  sessionOrder.indexOf(e.session),
  typeOrder.indexOf(e.type),
]);

/* agrupación por año + convocatoria, ya ordenado por el catálogo */
interface Group {
  year: number;
  session: Session;
  items: typeof exams;
}
const groups: Group[] = [];
for (const exam of exams) {
  const last = groups[groups.length - 1];
  if (last && last.year === exam.year && last.session === exam.session) last.items.push(exam);
  else groups.push({ year: exam.year, session: exam.session, items: [exam] });
}

const fmtSize = (kb?: number | null) => {
  if (!kb) return '';
  return kb < 1024 ? `${kb} KB` : `${(kb / 1024).toFixed(1)} MB`;
};

const yearLabel = (list: number[]) =>
  list.length === 0
    ? 'sin documentos'
    : list.length <= 3
      ? list.join(', ')
      : `${list[list.length - 1]}–${list[0]}`;

const phaseLabel = (phases: string[]) =>
  phases.map((p) => (p === 'acceso' ? 'Fase de acceso' : 'Fase de admisión')).join(' · ');

/* el mosaico separa lo que ya está de lo que aún no: las materias sin
   documentos quedan al final, con un trazo discontinuo */
const docSubjects = visibleSubjects.filter((s) => usedCodes.has(s.code));
const pendingSubjects = visibleSubjects.filter((s) => !usedCodes.has(s.code));

/* el pie enlaza solo lo que existe: nada de anunciar asignaturas vacías */
const footSubjects = docSubjects.slice(0, 8);
---

<Base
  title="WebPAU · Todos los exámenes de la PAU en Andalucía"
  description="Archivo de enunciados, soluciones y criterios de corrección de la PAU en Andalucía. Filtra por asignatura, año, convocatoria y fase y ábrelos en el navegador."
>
  <header class="site-head">
    <div class="wrap head-bar">
      <a class="brand" href={`${base}/`}>
        <span class="mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        WebPAU
      </a>
      <nav class="head-nav" aria-label="Secciones">
        {/* el mosaico solo existe si hay documentos que enseñar */}
        {exams.length > 0 && <a href="#asignaturas">Asignaturas</a>}
        <a href="#archivo">Archivo</a>
        <a href={`${base}/practica`}>Practicar</a>
      </nav>
      <p class="head-meta mono">
        <span class="hide-s">{statDocs} documentos</span>
        <span class="sep hide-s" aria-hidden="true">·</span>
        <span class="hide-s">{statSubjects} asignaturas</span>
      </p>
      <a
        class="cta"
        href="https://github.com/ElioXY/WebPAU"
        target="_blank"
        rel="noreferrer"
      >GitHub</a>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="wrap">
        <p class="kicker">PAU · Andalucía</p>
        <h1>Encuentra el ejercicio que <em>te toca</em>.</h1>
        <p class="lede">
          Enunciados, soluciones y criterios de corrección de la PAU en Andalucía,
          reunidos por asignatura, año y convocatoria. Elige una materia y abre sus
          PDFs en el navegador.
        </p>

        <NextExam />

        {exams.length > 0 && (
          <form class="filters" id="filters" role="search" autocomplete="off">
            <div class="filter-row find">
              <div class="field grow">
                <SearchIcon />
                <label class="visually-hidden" for="q">Buscar asignatura o texto</label>
                <input
                  class="input"
                  id="q"
                  name="q"
                  type="search"
                  placeholder="Buscar asignatura, año o convocatoria…"
                />
                <kbd class="kbd" aria-hidden="true">/</kbd>
              </div>

              <label class="visually-hidden" for="y">Año</label>
              <select class="select" id="y" name="y">
                <option value="">Todos los años</option>
                {years.map((y) => (
                  <option value={y}>{y} · {yearCounts.get(y)}</option>
                ))}
              </select>

              <label class="visually-hidden" for="phase">Fase</label>
              <select class="select" id="phase" name="phase">
                <option value="">Todas las fases</option>
                <option value="acceso">Fase de acceso</option>
                <option value="admision">Fase de admisión</option>
              </select>

              <button class="btn-primary" type="submit">Buscar</button>
            </div>

            <div class="filter-row tools">
              <div class="seg" role="group" aria-label="Convocatoria" id="segSession">
                <button type="button" data-ss="" aria-pressed="true">Cualquiera</button>
                {SESSIONS.map((s) => (
                  <button type="button" data-ss={s.id} aria-pressed="false">{s.label}</button>
                ))}
              </div>
              <div class="seg seg-type" role="group" aria-label="Tipo de documento" id="segType">
                <button type="button" data-t="" aria-pressed="true">Todos</button>
                {DOC_TYPES.map((t) => (
                  <button type="button" data-t={t.id} aria-pressed="false">{t.short}</button>
                ))}
              </div>
              <button type="button" class="btn-ghost" id="clearFilters" hidden>Limpiar filtros</button>
            </div>
          </form>
        )}
      </div>
    </section>

    {exams.length > 0 && (
      <section class="subjects" id="asignaturas">
        <div class="wrap">
          <div class="results-head">
            <h2>Explora por asignatura</h2>
            <p class="count">
              {statSubjects} {statSubjects === 1 ? 'materia' : 'materias'} · {range}
            </p>
          </div>

          <div class="legend">
            <span><i aria-hidden="true"></i> Fase de acceso</span>
            <span><i data-phase="admision" aria-hidden="true"></i> Fase de admisión</span>
            <span>Las barras marcan los años con documentos</span>
          </div>

          <div class="chips" role="group" aria-label="Asignatura" id="chips">
            <button
              class="chip"
              type="button"
              data-s=""
              data-phases="acceso,admision"
              aria-pressed="true"
            >
              <span class="nm">Todas las asignaturas</span>
              <span class="ct"><em>{statDocs}</em> docs. · {range}</span>
              <span class="bar" aria-hidden="true">
                {recentYears.map((y) => <i data-on={yearCounts.has(y) ? '1' : '0'} />)}
              </span>
            </button>

            {docSubjects.map((s) => {
              const list = subjectYears.get(s.code) ?? [];
              return (
                <button
                  class="chip"
                  type="button"
                  data-s={s.code}
                  data-phases={s.phases.join(',')}
                  aria-pressed="false"
                  title={`${s.name} · ${phaseLabel(s.phases)}`}
                >
                  <span class="nm">{s.name}</span>
                  <span class="ct">
                    <em>{subjectCounts.get(s.code) ?? 0}</em> docs. · {yearLabel(list)}
                  </span>
                  <span class="bar" aria-hidden="true">
                    {recentYears.map((y) => <i data-on={list.includes(y) ? '1' : '0'} />)}
                  </span>
                </button>
              );
            })}
          </div>

          {pendingSubjects.length > 0 && (
            <>
              <p class="chips-label">Aún sin documentos</p>
              <div class="chips chips-pending">
                {pendingSubjects.map((s) => (
                  <button
                    class="chip"
                    type="button"
                    data-s={s.code}
                    data-phases={s.phases.join(',')}
                    aria-pressed="false"
                    title={`${s.name} · ${phaseLabel(s.phases)}`}
                  >
                    <span class="nm">{s.name}</span>
                    <span class="ct"><em>0</em> docs.</span>
                    <span class="bar" aria-hidden="true">
                      {recentYears.map(() => <i data-on="0" />)}
                    </span>
                  </button>
                ))}
              </div>
            </>
          )}
        </div>
      </section>
    )}

    <section class="archive" id="archivo">
      <div class="wrap">
        <div class="results-head">
          <h2>Archivo</h2>
          <p class="count">
            <span id="resultCount">{statDocs}</span>&nbsp;{statDocs === 1 ? 'documento' : 'documentos'}
          </p>
        </div>

        <div id="results">
          {groups.length > 0 ? (
            groups.map((group) => (
              <div class="year-group" data-year={group.year} data-ss={group.session}>
                <div class="year-head">
                  <h3>{group.year}</h3>
                  <span class="session">{sessionLong.get(group.session) ?? group.session}</span>
                  <span class="n" data-group-count>
                    {group.items.length}&nbsp;{group.items.length === 1 ? 'documento' : 'documentos'}
                  </span>
                </div>
                {group.items.map((exam) => {
                  /* un tipo desconocido no debe tumbar el build entero: se
                     muestra tal cual en vez de reventar */
                  const type = typeById.get(exam.type) ?? {
                    id: exam.type,
                    short: exam.type,
                    label: exam.type,
                    hint: 'Tipo de documento no reconocido',
                  };
                  const meta = [
                    exam.subject,
                    exam.pages ? `${exam.pages} p.` : null,
                    fmtSize(exam.sizeKB),
                  ]
                    .filter(Boolean)
                    .join('  ·  ');
                  return (
                    <div
                      class="row"
                      data-id={exam.id}
                      data-s={exam.subject}
                      data-p={subjectPhases.get(exam.subject) ?? ''}
                      data-y={exam.year}
                      data-ss={exam.session}
                      data-t={exam.type}
                    >
                      <span class="stripe" aria-hidden="true"></span>
                      <div class="row-title">
                        <a
                          href={pdfUrl(exam.file)}
                          title={exam.notes || undefined}
                          target="_blank"
                          rel="noreferrer"
                        >
                          {subjectLabel(subjects, exam.subject)}
                        </a>
                        <p class="row-meta">{meta}</p>
                      </div>
                      {exam.official === false && (
                        <span class="unofficial" title="Documento no oficial">no oficial</span>
                      )}
                      <span class="tag" data-t={exam.type} title={type.hint}>
                        <i aria-hidden="true"></i>
                        {type.short}
                      </span>
                      <div class="row-actions">
                        {/* el PDF se abre en el visor del navegador: sin `download`,
                            que obligaba a guardarlo antes de poder leerlo */}
                        <a
                          class="dl"
                          href={pdfUrl(exam.file)}
                          target="_blank"
                          rel="noreferrer"
                        >
                          <OpenIcon /><span>Ver</span>
                        </a>
                      </div>
                    </div>
                  );
                })}
              </div>
            ))
          ) : (
            <div class="empty empty-state" id="catalogEmpty">
              <p class="badge" aria-hidden="true">0</p>
              <h2>Aún no hay nada en el archivo</h2>
              <p>
                Todavía no se ha publicado ningún examen. Cuando haya PDFs, aparecerán aquí
                ordenados por asignatura, año y convocatoria, listos para consultar.
              </p>
              <p class="empty-cta">
                <a
                  class="dl"
                  href="https://github.com/ElioXY/WebPAU"
                  target="_blank"
                  rel="noreferrer"
                >
                  <GitHubIcon /><span>Ver el proyecto en GitHub</span>
                </a>
              </p>
              <p class="owner-note mono">
                Si gestionas el archivo: entra en <code>/admin</code> con tu token de GitHub,
                sube el primero y pulsa «Publicar».
              </p>
            </div>
          )}

          <div class="empty" id="noMatches" hidden>
            <p class="badge" aria-hidden="true">?</p>
            <h2>Ningún documento coincide</h2>
            <p id="noMatchesText"></p>
            <p class="empty-cta">
              <button class="dl" type="button" id="clearFilters2">Quitar todos los filtros</button>
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-foot">
    <div class="wrap">
      <div class="foot-grid">
        <div>
          <h3>Sobre WebPAU</h3>
          <p>
            Archivo abierto de exámenes de la PAU en Andalucía. Cada documento se guarda
            en este repositorio con su asignatura, año, convocatoria y tipo, para que se
            pueda encontrar sin saber de dónde viene.
          </p>
        </div>
        <div>
          <h3>Asignaturas</h3>
          {footSubjects.length > 0 ? (
            <ul>
              {footSubjects.map((s) => (
                <li>
                  <a href={`?s=${s.code}#archivo`}>
                    {s.name} <span class="mono">{subjectCounts.get(s.code) ?? 0}</span>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p>Todavía no hay asignaturas con documentos publicados.</p>
          )}
        </div>
        <div>
          <h3>El proyecto</h3>
          <ul>
            <li><a href={`${base}/practica`}>Practicar un examen</a></li>
            <li><a href="https://github.com/ElioXY/WebPAU" target="_blank" rel="noreferrer">Código en GitHub</a></li>
            <li><a href="https://github.com/ElioXY/WebPAU/issues" target="_blank" rel="noreferrer">Falta un examen</a></li>
            <li><a href={`${base}/404`}>Página no encontrada</a></li>
          </ul>
        </div>
      </div>
      <p class="foot-note">
        Los documentos son de propiedad de los organismos que los emiten. WebPAU solo los
        reúne y los hace accesibles: si eres el titular de un documento y prefieres que
        no se difunda, abre un issue en el repositorio y lo quitamos.
      </p>
    </div>
  </footer>

  <script type="application/json" id="catalog-data" set:html={JSON.stringify({
    exams: compact,
    subjects: visibleSubjects.map((s) => [s.code, s.phases.join(','), s.name]),
    types: DOC_TYPES.map((t) => [t.id, t.short, t.label]),
    sessions: SESSIONS.map((s) => [s.id, s.long]),
    base,
  })} />

  <script>
    import '../scripts/archive.ts';
  </script>
</Base>
