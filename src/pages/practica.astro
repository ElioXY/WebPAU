---
/* =========================================================================
   Modo práctica (índice): qué exámenes se pueden hacer a tiempo.

   Cada examen tiene su propia página estática (`/practica/fis-2026-ordinaria`),
   así el cronómetro funciona sin servidor y el enlace se puede compartir.

   La página se lee como la portada: ficha, buscador y un índice por
   asignatura. Con más de doscientos practicables no se vuelcan todos de golpe:
   cada asignatura enseña sus tres convocatorias más recientes y el resto se
   abre eligiéndola arriba.
   ========================================================================= */
import Base from '../layouts/Base.astro';
import HeadNav from '../components/HeadNav.astro';
import SearchIcon from '../components/icons/Search.astro';
import { DOC_TYPES, SESSIONS, loadSubjects, type DocType } from '../lib/catalog';
import { practiceSets } from '../lib/practice';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const subjects = loadSubjects();
const sets = practiceSets();

/* años del listado, para el filtro del buscador */
const years = [...new Set(sets.map((set) => set.year))].sort((a, b) => b - a);
const yearCounts = new Map<number, number>();
for (const set of sets) yearCounts.set(set.year, (yearCounts.get(set.year) ?? 0) + 1);

const subjectName = (code: string) => subjects.find((s) => s.code === code)?.name ?? code;
const sessionLong = (id: string) => SESSIONS.find((s) => s.id === id)?.long ?? id;
const sessionShort = (id: string) => SESSIONS.find((s) => s.id === id)?.label ?? id;
const typeLabel = (id: string) => DOC_TYPES.find((t) => t.id === id)?.label ?? id;

/* «2018–2026» o la lista corta, como en la ficha del archivo */
const rangeLabel = (list: typeof sets): string => {
  const wanted = [...new Set(list.map((set) => set.year))].sort((a, b) => b - a);
  if (wanted.length === 0) return '—';
  return wanted.length <= 3 ? wanted.join(', ') : `${wanted[wanted.length - 1]}–${wanted[0]}`;
};

const allRange = rangeLabel(sets);
const sessionSummary =
  SESSIONS.filter((session) => sets.some((set) => set.session === session.id))
    .map((session) =>
      session.id === 'ordinaria'
        ? 'jun'
        : session.id === 'extraordinaria'
          ? 'sep'
          : session.label.toLowerCase()
    )
    .join(' · ') || '—';

interface SetGroup {
  code: string;
  name: string;
  sets: typeof sets;
}

const groups: SetGroup[] = [];
for (const set of sets) {
  const group = groups.find((g) => g.code === set.subject);
  if (group) group.sets.push(set);
  else groups.push({ code: set.subject, name: subjectName(set.subject), sets: [set] });
}
/* primero las asignaturas con exámenes más recientes: lo que se va a practicar
   suele ser la última convocatoria */
const latest = (group: SetGroup) => Math.max(...group.sets.map((set) => set.year));
groups.sort((a, b) => latest(b) - latest(a) || a.name.localeCompare(b.name, 'es'));

/* sin filtros, cada asignatura enseña solo la punta del índice */
const VISIBLE = 3;
---

<Base
  title="Practicar un examen de la PAU — WebPAU"
  description="Haz un examen de la PAU como en el aula: elige asignatura y convocatoria, pon el cronómetro y descubre las soluciones y los criterios al terminar."
>
  <header class="site-head">
    <div class="wrap head-bar">
      <a class="brand" href={`${base}/`}>
        <span class="mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        WebPAU
      </a>
      <HeadNav current="practica" />
      <a class="cta" href={`${base}/`}>Volver al archivo</a>
    </div>
  </header>

  <main>
    {sets.length === 0 ? (
      <section class="archive">
        <div class="wrap">
          <div class="empty">
            <p class="badge" aria-hidden="true">0</p>
            <h2>Todavía no hay exámenes que practicar</h2>
            <p>
              En cuanto haya un enunciado en el archivo, aparecerá aquí con su cronómetro.
              Mientras tanto, puedes <a class="link" href={`${base}/archivo`}>
                ver el archivo completo
              </a>.
            </p>
          </div>
        </div>
      </section>
    ) : (
      <>
        <section class="hero practice-hero">
          <div class="wrap">
            <div class="hero-grid">
              <div class="hero-copy">
                <p class="kicker">Práctica</p>
                <h1>Haz el examen <em>a tiempo</em>.</h1>
                <p class="lede">
                  Elige convocatoria, pon el cronómetro y trabaja con el enunciado al lado. Al
                  terminar, las soluciones y los criterios se abren en el mismo panel.
                </p>
              </div>

              <aside class="ficha" aria-label="Ficha de la práctica">
                <h2>Ficha de la práctica</h2>
                <dl>
                  <div><dt>Exámenes</dt><dd>{sets.length}</dd></div>
                  <div><dt>Asignaturas</dt><dd>{groups.length}</dd></div>
                  <div><dt>Años</dt><dd>{allRange}</dd></div>
                  <div><dt>Convocatorias</dt><dd>{sessionSummary}</dd></div>
                </dl>
              </aside>
            </div>

            <form class="filters home-search practice-search" role="search" autocomplete="off">
              <div class="filter-row find">
                <div class="field grow">
                  <SearchIcon />
                  <label class="visually-hidden" for="q">Buscar un examen</label>
                  <input
                    class="input"
                    id="q"
                    name="q"
                    type="search"
                    placeholder="Buscar asignatura, año o convocatoria…"
                  />
                  <kbd class="kbd" aria-hidden="true">/</kbd>
                </div>

                <label class="visually-hidden" for="py">Año</label>
                <select class="select" id="py" name="py">
                  <option value="">Todos los años</option>
                  {years.map((year) => (
                    <option value={year}>{year} · {yearCounts.get(year)}</option>
                  ))}
                </select>

                <button class="btn-ghost" type="button" id="practiceClear" hidden>
                  Limpiar
                </button>
              </div>

              <p class="practice-count mono" id="practiceCount" aria-live="polite">
                {sets.length} {sets.length === 1 ? 'examen' : 'exámenes'}
              </p>
            </form>
          </div>
        </section>

        <section class="archive" id="examenes">
          <div class="wrap">
            <div class="results-head" data-reveal>
              <h2>Elige asignatura</h2>
              <p class="count">
                {sets.length} {sets.length === 1 ? 'examen' : 'exámenes'} · {groups.length}{' '}
                {groups.length === 1 ? 'asignatura' : 'asignaturas'}
              </p>
            </div>

            <div class="chips practice-chips" role="group" aria-label="Asignatura">
              <button
                class="chip chip-all"
                type="button"
                data-subject-filter=""
                aria-pressed="true"
              >
                <span class="nm">Todas</span>
                <span class="ct"><em>{sets.length}</em> exámenes</span>
              </button>

              {groups.map((group) => (
                <button
                  class="chip"
                  type="button"
                  data-subject-filter={group.code}
                  aria-pressed="false"
                >
                  <span class="nm">{group.name}</span>
                  <span class="ct">
                    <em>{group.sets.length}</em> · {rangeLabel(group.sets)}
                  </span>
                </button>
              ))}
            </div>

            {groups.map((group) => (
              <section
                class="practice-subject"
                id={`practica-${group.code.toLowerCase()}`}
                data-group={group.code}
                data-reveal
              >
                <div class="practice-subject-head">
                  <h3>{group.name}</h3>
                  <p class="n" data-group-count>
                    {group.sets.length} {group.sets.length === 1 ? 'examen' : 'exámenes'} ·{' '}
                    {rangeLabel(group.sets)}
                  </p>
                </div>

                <ul class="practice-list">
                  {group.sets.map((set, index) => {
                    const docs = (
                      ['enunciados', 'soluciones', 'criterios', 'plantilla'] as DocType[]
                    ).filter((type) => set.docs[type]);
                    const corrected = docs.some((type) => type !== 'enunciados');
                    return (
                      <li
                        class="row"
                        data-set
                        data-year={set.year}
                        data-q={`${group.name} ${set.year} ${sessionLong(set.session)} ${docs
                          .map((type) => typeLabel(type))
                          .join(' ')}`}
                        data-extra={index >= VISIBLE ? '' : undefined}
                      >
                        <span class="stripe" aria-hidden="true" />
                        <span class="row-code mono" aria-hidden="true">{set.year}</span>
                        <div class="row-title">
                          <a href={`${base}/practica/${set.slug}`}>
                            {sessionLong(set.session)}
                          </a>
                          <p class="row-meta">
                            {docs.length} {docs.length === 1 ? 'documento' : 'documentos'} ·{' '}
                            {docs.map((type) => typeLabel(type)).join(', ')}
                          </p>
                        </div>
                        <span class="tag" data-t={corrected ? 'soluciones' : 'enunciados'}>
                          {corrected ? 'Con corrección' : 'Solo enunciado'}
                        </span>
                        <div class="row-actions">
                          <a class="dl" href={`${base}/practica/${set.slug}`}>
                            Practicar
                          </a>
                        </div>
                      </li>
                    );
                  })}
                </ul>

                {group.sets.length > VISIBLE && (
                  <p class="practice-more">
                    <button class="dl" type="button" data-show-all={group.code}>
                      Ver los {group.sets.length} exámenes
                    </button>
                  </p>
                )}
              </section>
            ))}

            <p class="practice-empty" id="practiceEmpty" hidden>
              No hay exámenes con esos filtros. Prueba con otra asignatura, otro año, o borra la
              búsqueda.
            </p>

            <p class="practice-note" data-reveal>
              Sin cronómetro también sirve: en el{' '}
              <a class="link" href={`${base}/archivo`}>archivo</a> están todos los documentos,
              con sus enunciados y correcciones.
            </p>
          </div>
        </section>
      </>
    )}
  </main>

  <script>
    import '../scripts/practice-filter.ts';
  </script>
</Base>
