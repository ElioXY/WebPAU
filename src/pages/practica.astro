---
/* =========================================================================
   Modo práctica (índice): qué exámenes se pueden hacer a tiempo.

   Cada examen tiene su propia página estática (`/practica/fis-2026-ordinaria`),
   así el cronómetro funciona sin servidor y el enlace se puede compartir.

   Los exámenes se agrupan por asignatura: con más de doscientos practicables,
   una lista suelta era imposible de recorrer.
   ========================================================================= */
import Base from '../layouts/Base.astro';
import HeadNav from '../components/HeadNav.astro';
import SearchIcon from '../components/icons/Search.astro';
import { DOC_TYPES, SESSIONS, loadSubjects, type DocType } from '../lib/catalog';
import { practiceSets } from '../lib/practice';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const subjects = loadSubjects();
const sets = practiceSets();

/* años del listado, para el filtro del buscador */
const years = [...new Set(sets.map((set) => set.year))].sort((a, b) => b - a);
const yearCounts = new Map<number, number>();
for (const set of sets) yearCounts.set(set.year, (yearCounts.get(set.year) ?? 0) + 1);

const subjectName = (code: string) => subjects.find((s) => s.code === code)?.name ?? code;
const sessionLong = (id: string) => SESSIONS.find((s) => s.id === id)?.long ?? id;
const typeLabel = (id: string) => DOC_TYPES.find((t) => t.id === id)?.label ?? id;

interface SetGroup {
  code: string;
  name: string;
  sets: typeof sets;
}

const groups: SetGroup[] = [];
for (const set of sets) {
  const group = groups.find((g) => g.code === set.subject);
  if (group) group.sets.push(set);
  else groups.push({ code: set.subject, name: subjectName(set.subject), sets: [set] });
}
/* primero las asignaturas con exámenes más recientes: lo que se va a practicar
   suele ser la última convocatoria */
const latest = (group: SetGroup) => Math.max(...group.sets.map((set) => set.year));
groups.sort((a, b) => latest(b) - latest(a) || a.name.localeCompare(b.name, 'es'));
---

<Base
  title="Practicar un examen de la PAU — WebPAU"
  description="Haz un examen de la PAU como en el aula: elige asignatura y convocatoria, pon el cronómetro y descubre las soluciones y los criterios al terminar."
>
  <header class="site-head">
    <div class="wrap head-bar">
      <a class="brand" href={`${base}/`}>
        <span class="mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        WebPAU
      </a>
      <HeadNav current="practica" />
      <a class="cta" href={`${base}/`}>Volver al archivo</a>
    </div>
  </header>

  <main>
    <section class="hero practice-hero">
      <div class="wrap">
        <p class="kicker">Práctica</p>
        <h1>Haz el examen <em>a tiempo</em>.</h1>
        <p class="lede">
          Elige un examen del archivo, pon el cronómetro y trabaja con el enunciado delante. Las
          soluciones y los criterios quedan tapados hasta que termines.
        </p>
      </div>
    </section>

    {sets.length === 0 ? (
      <section class="archive">
        <div class="wrap">
          <div class="empty">
            <p class="badge" aria-hidden="true">0</p>
            <h2>Todavía no hay exámenes que practicar</h2>
            <p>
              En cuanto haya un enunciado en el archivo, aparecerá aquí con su cronómetro. Mientras
              tanto, puedes <a class="link" href={`${base}/archivo`}>ver el archivo completo</a>.
            </p>
          </div>
        </div>
      </section>
    ) : (
      <section class="archive">
        <div class="wrap">
          <div class="results-head" data-reveal>
            <h2>Exámenes listos para practicar</h2>
            <p class="count">
              {sets.length} {sets.length === 1 ? 'examen' : 'exámenes'} · {groups.length}{' '}
              {groups.length === 1 ? 'asignatura' : 'asignaturas'}
            </p>
          </div>

          <form class="filters practice-search" role="search" autocomplete="off">
            <div class="filter-row find">
              <div class="field grow">
                <SearchIcon />
                <label class="visually-hidden" for="q">Buscar un examen</label>
                <input
                  class="input"
                  id="q"
                  name="q"
                  type="search"
                  placeholder="Buscar asignatura, año o convocatoria…"
                />
                <kbd class="kbd" aria-hidden="true">/</kbd>
              </div>

              <label class="visually-hidden" for="py">Año</label>
              <select class="select" id="py" name="py">
                <option value="">Todos los años</option>
                {years.map((year) => (
                  <option value={year}>{year} · {yearCounts.get(year)}</option>
                ))}
              </select>

              <button class="btn-ghost" type="button" id="practiceClear" hidden>
                Limpiar
              </button>
            </div>

            <p class="practice-count mono" id="practiceCount" aria-live="polite">
              {sets.length} {sets.length === 1 ? 'examen' : 'exámenes'}
            </p>
          </form>

          {groups.map((group) => (
            <section class="practice-subject" data-subject data-reveal>
              <div class="practice-subject-head">
                <h3>{group.name}</h3>
                <p class="n" data-group-count>
                  {group.sets.length} {group.sets.length === 1 ? 'examen' : 'exámenes'}
                </p>
              </div>

              <ul class="practice-list">
                {group.sets.map((set) => {
                  const docs = (['enunciados', 'soluciones', 'criterios', 'plantilla'] as DocType[]).filter(
                    (type) => set.docs[type]
                  );
                  return (
                    <li
                      class="practice-set"
                      data-set
                      data-year={set.year}
                      data-q={`${group.name} ${set.year} ${sessionLong(set.session)} ${docs
                        .map((type) => typeLabel(type))
                        .join(' ')}`}
                    >
                      <div class="practice-set-main">
                        <h4>
                          {set.year} · {sessionLong(set.session)}
                        </h4>
                        <p class="row-meta">
                          {docs.length} {docs.length === 1 ? 'documento' : 'documentos'}
                        </p>
                      </div>
                      <ul class="practice-docs" aria-label="Documentos disponibles">
                        {docs.map((type) => (
                          <li data-t={type}>{typeLabel(type)}</li>
                        ))}
                      </ul>
                      <a class="dl" href={`${base}/practica/${set.slug}`}>
                        Practicar
                      </a>
                    </li>
                  );
                })}
              </ul>
            </section>
          ))}

          <p class="practice-empty" id="practiceEmpty" hidden>
            No hay exámenes con esos filtros. Prueba con otra asignatura, otro año, o borra la
            búsqueda.
          </p>

          <p class="practice-note" data-reveal>
            Sin cronómetro también sirve: en el <a class="link" href={`${base}/archivo`}>archivo</a>{' '}
            están todos los documentos, con sus enunciados y correcciones.
          </p>
        </div>
      </section>
    )}
  </main>

  <script>
    import '../scripts/practice-filter.ts';
  </script>
</Base>
